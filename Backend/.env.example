# Enterprise Knowledge Search (EKS) - Environment Configuration
# Copy this file to .env and configure your local or production credentials.

# LLM API Keys (Google Gemini or OpenAI - Never hardcode in source code)
GEMINI_API_KEY=
OPENAI_API_KEY=

# LLM & Embedding Models (e.g. gemini-3.8-flash for Gemini, gpt-4o-mini for OpenAI)
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gemini-3.8-flash

# Qdrant Vector Database (Docker, Qdrant Cloud Online, or Embedded Local)
# For local Docker: http://localhost:6333
# For Qdrant Cloud (free online cluster): https://xxxxxx.eu-central.aws.cloud.qdrant.io:6333
# If QDRANT_URL is left empty, local on-disk storage is used at QDRANT_PATH
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=enterprise_knowledge
QDRANT_PATH=./qdrant_storage

# Token-Based Chunking Parameters (Counted using tiktoken)
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# Two-stage Retrieval & Filtering Architecture
RETRIEVE_K=20
TOP_K_CHUNKS=5
MIN_SIMILARITY=0.0

# Ingestion Limits
MAX_UPLOAD_MB=25
MAX_PAGES=150
EMBED_BATCH_SIZE=64

# LLM Inference Limits & Determinism
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0

# Google OAuth 2.0 Credentials (Get from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

